# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# capturas e registros do Playwright MCP (teste no navegador)
/.playwright-mcp/

# resultados dos testes de navegador (npm run test:e2e)
/e2e-resultados/
/e2e-relatorio/
/e2e-emails/

# cópias do banco (npm run banco:backup): têm dados pessoais, nunca no Git
/backups/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# exceção: o modelo de variáveis de ambiente vai para o Git
!.env.example
