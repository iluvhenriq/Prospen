# Copie este arquivo para .env.local e preencha os valores.
# O .env.local nunca vai para o Git. Nunca coloque chaves reais neste arquivo.

# Banco de dados (etapa 1)
# Troque SUA_SENHA pela senha criada na instalação do PostgreSQL.
# Se a senha tiver símbolos como @ # / :, troque cada um pelo código correspondente
# (exemplo: @ vira %40). O nome do banco (prospen) pode ter só letras, números e _.
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/prospen

# Login (etapa 2)
# Segredo que protege as sessões de login. Para gerar um valor seguro, rode:
#   npm run auth:segredo
# e copie a linha AUTH_SECRET=... que aparecer no lugar da linha abaixo.
# Nunca compartilhe esse valor. Se ele vazar, gere outro (todos terão de entrar de novo).
AUTH_SECRET=
APP_URL=http://localhost:3000

# Modo pré-venda: com 1, o site mostra só a página de apresentação com o
# pré-cadastro e as páginas legais; cadastro, entrada e painel ficam fechados.
# Use 1 no site publicado durante a pré-venda. Mude ANTES do build. Não é segredo.
MODO_PRE_VENDA=

# Base pública de CNPJ (etapa 5). Pasta onde os arquivos da Receita são baixados.
# Opcional: sem ela, o padrão é D:\prospen-dados\cnpj. Não é segredo.
CNPJ_PASTA_DADOS=

# E-mail de confirmação de conta e de senha nova (28/10/2026), por SMTP.
# Opcional: sem SMTP_HOST, o e-mail não sai e o link aparece no terminal do
# servidor (serve para testar no seu computador).
# Com o Gmail (grátis, uns 500 e-mails por dia):
#   1. Ative a verificação em duas etapas na conta Google.
#   2. Crie uma "senha de app" em https://myaccount.google.com/apppasswords
#   3. Preencha abaixo: SMTP_HOST=smtp.gmail.com, SMTP_USUARIO com o seu Gmail
#      e SMTP_SENHA com a senha de app (16 letras). NUNCA a senha normal da conta.
# SMTP_SENHA é segredo: só no .env.local. SMTP_PORTA vazia usa a 465.
SMTP_HOST=
SMTP_PORTA=
SMTP_USUARIO=
SMTP_SENHA=
# Opcional. Nome e endereço de quem envia. Vazio: PROSPEN <SMTP_USUARIO>.
EMAIL_REMETENTE=

# Ainda não usada. Google Places (etapa 6). Só no servidor, nunca na interface.
GOOGLE_PLACES_API_KEY=
