# Copie este arquivo para .env.local e preencha os valores.
# O .env.local nunca vai para o Git. Nunca coloque chaves reais neste arquivo.

# Banco de dados (etapa 1)
# Troque SUA_SENHA pela senha criada na instalação do PostgreSQL.
# Se a senha tiver símbolos como @ # / :, troque cada um pelo código correspondente
# (exemplo: @ vira %40). O nome do banco (prospen) pode ter só letras, números e _.
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/prospen

# Login (etapa 2)
# Segredo que protege as sessões de login. Para gerar um valor seguro, rode:
#   npm run auth:segredo
# e copie a linha AUTH_SECRET=... que aparecer no lugar da linha abaixo.
# Nunca compartilhe esse valor. Se ele vazar, gere outro (todos terão de entrar de novo).
AUTH_SECRET=
APP_URL=http://localhost:3000

# Ainda não usadas. Entram quando o produto passar a enviar e-mails e a consultar o Google.
# Google Places (etapa 6). Só no servidor, nunca na interface.
GOOGLE_PLACES_API_KEY=
# E-mail de confirmação e recuperação de senha.
EMAIL_API_KEY=
EMAIL_FROM=
